# Конфиг списка серверов для PolySrv
#
# Этот файл — единственное место, где задаётся, откуда клиент берёт список
# серверов (официальные DC Telegram и т.д.). Кладёшь на любой CDN
# (jsDelivr, Cloudflare, свой S3/nginx, raw.githubusercontent) и меняешь адрес здесь.
#
# Формат файла: серверы лежат в переменной SERVERS_JSON (обычный JSON, одна строка).
# Клиент читает файл целиком и разбирает его как .env; если файл начинается с "{",
# он разбирается как обычный JSON.

# URL конфига серверов. Основной — сайт на GitHub Pages (ветка gh-pages),
# там же update.json. Фолбэк — raw.githubusercontent на случай недоступности сайта.
# Поддерживается plain JSON или .env с переменной SERVERS_JSON.
SERVERS_CONFIG_URL=

# Запасной источник (если основной недоступен или отдаёт старый кэш)
SERVERS_CONFIG_URL_FALLBACK=

# Таймаут загрузки конфига, мс
SERVERS_CONFIG_TIMEOUT_MS=5000

# Как долго кэшировать скачанный конфиг, мс (0 = до перезапуска приложения)
SERVERS_CONFIG_CACHE_TTL_MS=3600000

# Список серверов (адреса DC, RSA-ключи, имена).
SERVERS_JSON={"version":1,"updated":"2026-11-25","servers":[{"id":"ezchat","name":"EzChat","description":"EzChat messenger, connected to ezchat.im.","host":"ezchat.im","port":2398,"isTelegram":false,"multiDc":false,"mainDcId":1,"rsaPublicKey":"-----BEGIN RSA PUBLIC KEY-----\nMIIBCgKCAQEAnE5VnML5MLp0/oVqvdoAC0OxNIz9idmJ+n2LAXbbvILO+OKYxFo3\naNoBhnW0QEekPYpUvDqRaHLL3yt92aWxUdeFhLmeabdFU85YSUmZ+Awz7BiKamIA\n93m1w8tI9AttQ/Xv5dtHiQaVA8+zuAQOPZmxF6capvqP59r9NOTrvtLWChxSZIMl\nl8zW5S+G5QZ/vMf1ox8LSitpUI/vWSYSmEDX2BBpi3s4v6hBS+9Jk5J30DS12NjT\nQAf5wOvO+SCPeNiXm5W8JD8vCwZirtPHk+WP9DpMoCdnDJixFYlXd9RjA+3dMBOb\nodXuj4QDR8YO4dM8IL73cLuLYmtw4Z24cwIDAQAB\n-----END RSA PUBLIC KEY-----","rsaKeyFingerprint":-1399974346619280757,"dc":[]}]}
